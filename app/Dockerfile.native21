# Stage 1: Build GraalVM Native Image with Java 21
FROM ghcr.io/graalvm/native-image-community:21 AS builder

WORKDIR /build

RUN microdnf install -y maven findutils

COPY pom.xml .
RUN mvn -B dependency:go-offline -DskipTests || true

COPY src ./src
RUN mvn -B -Pnative -DskipTests package

# Stage 2: Minimal runtime image (Security Hardened Non-Root User)
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    zlib1g \
    libstdc++6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system user and group
RUN groupadd -g 1000 appgroup && useradd -u 1000 -g appgroup -ms /bin/bash appuser

WORKDIR /app

COPY --from=builder /build/target/benchmark-native /app/benchmark-native
RUN chmod +x /app/benchmark-native && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8080

ENTRYPOINT ["/app/benchmark-native", "-XX:+PrintGC"]

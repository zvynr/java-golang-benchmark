# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file containing production secrets to version control.
# ==============================================================================

# --- PostgreSQL Database Configuration ---
POSTGRES_DB=benchmark
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=change_me_secure_postgres_password_123

# --- Application Database Connection (Shared by JVM, Native, & Go) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=benchmark
DB_USER=benchmark
DB_PASSWORD=change_me_secure_postgres_password_123

# --- Grafana Monitoring Credentials ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_secure_grafana_password_123
GF_USERS_ALLOW_SIGN_UP=false

# --- k6 Load Testing Parameters ---
BASE_URL=http://app-jvm:8080
VU=10

# --- Go Service Runtime Parameters ---
GOMAXPROCS=2
#GOMEMLIMIT=1000MiB
GOGC=100
GIN_MODE=release
DB_MAX_OPEN=20
DB_MAX_IDLE=5
